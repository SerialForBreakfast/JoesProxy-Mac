<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "1610"
   version = "1.7">
   <!-- Local-use-only scheme (AO residual gap): builds and runs JoesProxy against the
        "Release-MenuBarOnly" configuration, which sets LSUIElement statically so no Dock icon ever
        appears, not even briefly at cold start (unlike the runtime `.accessory` Settings toggle).
        Not wired into CI or the notarization/release pipeline — see the standard "JoesProxy"
        scheme/"Release" configuration for the distributed build. -->
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES"
      buildArchitectures = "Automatic">
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "NO"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "4498EC182CDAED9900844D6D"
               BuildableName = "JoesProxy.app"
               BlueprintName = "JoesProxy"
               ReferencedContainer = "container:JoesProxy.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction
      buildConfiguration = "Release-MenuBarOnly"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <Testables>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Release-MenuBarOnly"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "4498EC182CDAED9900844D6D"
            BuildableName = "JoesProxy.app"
            BlueprintName = "JoesProxy"
            ReferencedContainer = "container:JoesProxy.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release-MenuBarOnly"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "4498EC182CDAED9900844D6D"
            BuildableName = "JoesProxy.app"
            BlueprintName = "JoesProxy"
            ReferencedContainer = "container:JoesProxy.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction
      buildConfiguration = "Release-MenuBarOnly">
   </AnalyzeAction>
   <ArchiveAction
      buildConfiguration = "Release-MenuBarOnly"
      revealArchiveInOrganizer = "YES">
   </ArchiveAction>
</Scheme>
